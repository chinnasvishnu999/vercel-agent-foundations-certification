# Copy to .env.local (git-ignored) and fill in, or run `vercel env pull .env.local`
# after `vercel link`. Never commit real values or prefix secrets with NEXT_PUBLIC_.

# Required. Vercel deployment-protection bypass for the store API. Sent from the
# server on every API call; never sent to the browser or returned by an agent.
BYPASS_SECRET=

# Required. Base URL of the Vercel Swag Store API, ending in /api.
# Prepopulated by the template's Deploy button; keep the provided value.
API_BASE_URL=

# AI Gateway authentication (one of the two):
# - VERCEL_OIDC_TOKEN: written by `vercel env pull`; expires after 12 hours locally.
#   On Vercel deployments OIDC is automatic, so nothing needs to be set there.
# - AI_GATEWAY_API_KEY: an AI Gateway API key, used instead of OIDC when set.
VERCEL_OIDC_TOKEN=
AI_GATEWAY_API_KEY=

# Optional. AI Gateway model for the shopping agent (must support tool calls).
# Defaults to openai/gpt-4.1-mini.
SHOPPING_AGENT_MODEL=

# Optional. AI Gateway model for the store admin agent. Defaults to openai/gpt-4.1.
ADMIN_AGENT_MODEL=

# Optional. Public site URL used for metadata. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
